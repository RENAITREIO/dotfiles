layout {

    focus-ring {
        active-color   "#bec4ee"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bec4ee"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bec4ee"
        inactive-color "#696f95"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bec4ee80"
    }
}

recent-windows {
    highlight {
        active-color "#bec4ee"
        urgent-color "#ffb4ab"
    }
}
