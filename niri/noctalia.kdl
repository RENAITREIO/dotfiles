layout {

    focus-ring {
        active-color   "#81cfff"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#81cfff"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#81cfff"
        inactive-color "#4399c8"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#81cfff80"
    }
}

recent-windows {
    highlight {
        active-color "#81cfff"
        urgent-color "#ffb4ab"
    }
}
